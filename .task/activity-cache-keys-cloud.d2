direction: down

# ---------- Legend (horizontal, at top) ----------

legend: {
  label: ""
  direction: right

  yellow: "In-memory (LRU cache)" {
    style.fill: "#ffe066"
    style.stroke: "#8a6d00"
    style.stroke-width: 3
  }
  green: "WAL (BookKeeper/BOSS)\nDurability point on sync path" {
    style.fill: "#b8e8b8"
    style.stroke: "#1a6b1a"
    style.stroke-width: 3
  }
  blue: "CDS layer\n(saas-temporal)" {
    style.fill: "#b8d4f0"
    style.stroke: "#1a5276"
    style.stroke-width: 3
  }
  red: "Database (Cassandra/Walker)\nOnly on Element cache miss" {
    style.fill: "#f5a0a0"
    style.stroke: "#a01010"
    style.stroke-width: 3
  }
  orange: "Tiered storage (S3)" {
    style.fill: "#f5d6a0"
    style.stroke: "#a06010"
    style.stroke-width: 3
  }
}

# ---------- Activity handler operations ----------

handler: Activity Handler {
  start: StartActivityExecution {
    style.fill: "#b8e6b8"
    style.stroke: "#1a6b1a"
    style.stroke-width: 2
  }
  describe: DescribeActivityExecution {
    style.fill: "#c8b8e8"
    style.stroke: "#4a2d8a"
    style.stroke-width: 2
  }
  poll: PollActivityExecution {
    style.fill: "#c8b8e8"
    style.stroke: "#4a2d8a"
    style.stroke-width: 2
  }
  terminate: TerminateActivityExecution {
    style.fill: "#c8b8e8"
    style.stroke: "#4a2d8a"
    style.stroke-width: 2
  }
  cancel: RequestCancelActivityExecution {
    style.fill: "#c8b8e8"
    style.stroke: "#4a2d8a"
    style.stroke-width: 2
  }
  delete: DeleteActivityExecution {
    style.fill: "#c8b8e8"
    style.stroke: "#4a2d8a"
    style.stroke-width: 2
  }
}

# ---------- Two divergent paths ----------

start_path: "Start path\n(no RunID known yet)" {
  style.fill: "#b8e6b8"
  style.stroke: "#1a6b1a"
  style.stroke-width: 2
}

lease_path: "Read/Mutate path" {
  style.fill: "#c8b8e8"
  style.stroke: "#4a2d8a"
  style.stroke-width: 2
}

handler.start -> start_path
handler.describe -> lease_path
handler.poll -> lease_path
handler.terminate -> lease_path
handler.cancel -> lease_path
handler.delete -> lease_path

