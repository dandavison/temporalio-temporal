  link: "https://github.com/temporalio/temporal/blob/f8bbf7c78/service/history/shard/context_impl.go#L569"
}

ctx_create -> shard_create

# ExecutionManager decorator chain
# CreateWorkflowExecution is NOT overridden by cds executionManagerImpl,
# so it passes through to OSS ExecutionManager, which serializes and
# calls the ExecutionStore.

exec_mgr_create: "OSS executionManager.CreateWorkflowExecution\nexecution_manager.go:72\nSerializes snapshot + events, calls store" {
  style.fill: "#ffffff"
  link: "https://github.com/temporalio/temporal/blob/f8bbf7c78/common/persistence/execution_manager.go#L72"
}

shard_create -> exec_mgr_create: "cds ExecutionManager\n(not overridden for Create)\n-> rate limiter -> metrics\n-> OSS retry -> OSS mgr"

# ================================================================
# CDS: ExecutionStoreWrapper replaces SQL/Cassandra store
# The sync write goes to WAL, not to the database.
# See: cds/export/cds/execution_store.go
# ================================================================

exec_store_wrapper: "ExecutionStoreWrapper.CreateWorkflowExecution\ncds/export/cds/execution_store.go\nImplements persistence.ExecutionStore\nConverts OSS request into WAL records" {
  style.fill: "#b8d4f0"
  style.stroke: "#1a5276"
  style.stroke-width: 3
  link: "https://github.com/temporalio/saas-temporal/blob/main/cds/export/cds/execution_store.go"
}

exec_mgr_create -> exec_store_wrapper {
  style.stroke: "#1a5276"
  style.stroke-width: 3
}

# runOperation: the multi-WAL write sequence

begin_op: "beginOperation()\ncds/export/cds/execution_runner.go:98\nLookup Element by DataKey{nsID, businessID, archetypeID}\nAcquire Element IO lock" {
  style.fill: "#b8d4f0"
  style.stroke: "#1a5276"
  style.stroke-width: 3
  link: "https://github.com/temporalio/saas-temporal/blob/main/cds/export/cds/execution_runner.go#L98"
}

exec_store_wrapper -> begin_op {
  style.stroke: "#1a5276"
  style.stroke-width: 3
}

element_hit: "Element in memory\n(write-behind cache)\nProceeds immediately" {
  style.fill: "#b8d4f0"
  style.stroke: "#1a5276"
  style.stroke-width: 3
}

element_miss: "Element not in memory\nRecover from WAL buffered records\nor read from DB\n(~50-80ms — the dedup read cost)" {
  style.fill: "#f5a0a0"
  style.stroke: "#a01010"
  style.stroke-width: 3
}

begin_op -> element_hit: "Element cached" {
  style.stroke: "#1a5276"
  style.stroke-width: 2
}

begin_op -> element_miss: "Element evicted" {
  style.stroke: "#a01010"
  style.stroke-width: 2
  style.stroke-dash: 5
}

prepare: "operation.Prepare()\nValidate against Element's in-memory state\nConvert to WAL records" {
  style.fill: "#b8d4f0"
  style.stroke: "#1a5276"
  style.stroke-width: 3
}

element_hit -> prepare
element_miss -> prepare

# WAL writes (durability point)

hewal_write: "HEWAL write\nHistory events to BookKeeper/BOSS\nvia shardInstance.HEWALWrite()" {
  style.fill: "#b8e8b8"
  style.stroke: "#1a6b1a"
  style.stroke-width: 3
  style.bold: true
}

prepare -> hewal_write: "no conflict\n(no current execution)" {
  style.stroke: "#1a6b1a"
  style.stroke-width: 3
}

mswal_write: "MSWAL write\nMutable state + tasks to BookKeeper/BOSS\nvia shardInstance.MSWALWrite()\nIncludes HE watermark cross-reference" {
  style.fill: "#b8e8b8"
  style.stroke: "#1a6b1a"
  style.stroke-width: 3
  style.bold: true
}

hewal_write -> mswal_write {
  style.stroke: "#1a6b1a"
  style.stroke-width: 3
}

apply: "In-memory apply\nMSApply + HEApply to Element\nElement marked dirty on flush list\n\nFlusher writes to DB asynchronously\n(~20s cycle)" {
  style.fill: "#b8d4f0"
  style.stroke: "#1a5276"
  style.stroke-width: 3
}

mswal_write -> apply {
  style.stroke: "#1a5276"
  style.stroke-width: 3
}

# Conflict path from Prepare

conflict: "handleExecutionConflict\nchasm_engine.go:902\nChecks requestID idempotency,\nthen applies reuse/conflict policy\n\nConflict data from Element state\n(no additional read needed)" {
  style.fill: "#ffffff"
  link: "https://github.com/temporalio/temporal/blob/f8bbf7c78/service/history/chasm_engine.go#L902"
}

prepare -> conflict: "current execution exists\n-> CurrentWorkflowConditionFailedError\n(carries existing RunID + RequestIDs)" {
  style.stroke-dash: 5
  style.stroke-width: 3
}

