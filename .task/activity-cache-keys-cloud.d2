# Descent into persistence (via CDS)

ctx_create: "ContextImpl.CreateWorkflowExecution\ncontext.go:237" {
  style.fill: "#ffffff"
  link: "https://github.com/temporalio/temporal/blob/f8bbf7c78/service/history/workflow/context.go#L237"
}

persist_brand_new -> ctx_create

